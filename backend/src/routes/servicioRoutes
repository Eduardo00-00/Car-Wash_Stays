const express = require('express');
const router = express.Router();
const servicioController = require('../controllers/servicioController');
const verificarToken = require('../middleware/authMiddleware'); 
const verificarRol = require('../middleware/roleMiddleware');

// Aplicamos el middleware a la ruta de agendar
router.post('/agendar', verificarToken, verificarRol(['cliente']), servicioController.agendarServicio);
router.patch('/actualizar-estado/:id', verificarToken, verificarRol(['lavador', 'admin']),  servicioController.cambiarEstado);

// NUEVA RUTA: GET inteligente para todos los roles
router.get('/mis-servicios', verificarToken, verificarRol(['admin', 'lavador', 'cliente']), servicioController.obtenerServicios);

module.exports = router;